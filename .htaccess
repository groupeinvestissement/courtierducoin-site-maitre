# Les anciennes routes Centre-Ville de Laval sont consolidées vers le secteur Laval.
RewriteRule ^secteurs/centre-ville-de-laval/?$ https://www.courtierducoin.ca/secteurs/laval/?entry=laval-universal [R=301,L,NE,QSA]
RewriteRule ^centre-ville-de-laval/(o1a11|02a22|03i33|04m44|05c55)/?$ https://www.courtierducoin.ca/laval/$1/?entry=laval-$1 [R=301,L,NE,QSA]

# Domaine maître : HTTPS et version www canonique.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.courtierducoin\.ca$ [NC]
RewriteRule ^ https://www.courtierducoin.ca%{REQUEST_URI} [R=301,L]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
